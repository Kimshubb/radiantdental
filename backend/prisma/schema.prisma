// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  name            String
  role            Role
  branches        BranchOnUser[] // Many-to-many for doctors & admins
  appointments    Appointment[]  @relation("DoctorAppointments")
  doctorProfile   DoctorProfile?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Optimized indexes
  @@index([email, role])
  @@index([createdAt])
}

model Branch {
  id             String       @id @default(uuid())
  name           String
  address        String
  phone          String
  users          BranchOnUser[]
  services       Service[]
  appointments   Appointment[]
  admin          User?        @relation(fields: [adminId], references: [id]) // Each branch has one admin
  adminId        String?      @unique
  
  @@index([name])
  @@index([address])
}

model BranchOnUser {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id])
  branch   Branch @relation(fields: [branchId], references: [id])
  @@id([userId, branchId]) // Composite primary key for many-to-many relation
}

model Appointment {
  id           String            @id @default(uuid())
  startTime    DateTime
  endTime      DateTime
  status       AppointmentStatus @default(SCHEDULED)
  patientName  String
  patientPhone String
  patientEmail String
  doctor       User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  doctorId     String
  branch       Branch            @relation(fields: [branchId], references: [id])
  branchId     String
  services     Service[]
  notes        String?
  source       AppointmentSource @default(WEB_FORM)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Critical indexes for common queries
  @@index([doctorId, startTime])
  @@index([branchId, startTime])
  @@index([status, startTime])
  @@index([patientPhone])
}

model Service {
  id          String  @id @default(uuid())
  name        String  @unique
  duration    Int     // Minutes
  description String?
  branches    Branch[] // Available at which branches

  @@index([name])
  @@index([duration])
}

model DoctorProfile {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String   @unique
  availability  Availability[]
  timePerPatient Int     @default(30) // Default 30 mins per patient
}

model Availability {
  id         String   @id @default(uuid())
  doctor     User     @relation(fields: [doctorId], references: [id])
  doctorId   String
  startTime  DateTime // Inclusive
  endTime    DateTime // Exclusive
  exceptions DateTime[]      // Dates when this availability doesn't apply
  
  @@index([doctorId, startTime])
}

enum Role {
  SUPERADMIN
  BRANCH_ADMIN
  DOCTOR
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  RESCHEDULED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  WEB_FORM
  PHONE
  WALK_IN
  RECOMMENDATION
}
